{
  "name": "st-weavememory-server",
  "version": "0.1.0",
  "description": "织忆（WeaveMemory）SillyTavern 服务端插件。",
  "main": "dist/plugin.js",
  "type": "commonjs",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:persistence": "tsc -p tsconfig.test.json && node .test-dist/tests/persistence-acceptance.js",
    "test:floor-reconcile": "tsc -p tsconfig.test.json && node .test-dist/tests/floor-reconcile-acceptance.js",
    "test:branch": "tsc -p tsconfig.test.json && node .test-dist/tests/branch-acceptance.js",
    "test:branch-fork": "tsc -p tsconfig.test.json && node .test-dist/tests/branch-fork-acceptance.js",
    "test:host-branch": "tsc -p tsconfig.test.json && node .test-dist/tests/host-branch-binding-acceptance.js",
    "test:state-schema": "tsc -p tsconfig.test.json && node .test-dist/tests/state-schema-acceptance.js",
    "test:ai-config": "tsc -p tsconfig.test.json && node .test-dist/tests/ai-config-acceptance.js",
    "test:ai-client": "tsc -p tsconfig.test.json && node .test-dist/tests/ai-client-acceptance.js",
    "test:state-task": "tsc -p tsconfig.test.json && node .test-dist/tests/state-task-acceptance.js",
    "test:state-diff": "tsc -p tsconfig.test.json && node .test-dist/tests/state-diff-acceptance.js",
    "test:state-chain": "tsc -p tsconfig.test.json && node .test-dist/tests/state-chain-acceptance.js",
    "test:state-chain-1000": "tsc -p tsconfig.test.json && node .test-dist/tests/state-chain-1000-acceptance.js",
    "test:state-rebuild": "tsc -p tsconfig.test.json && node .test-dist/tests/state-rebuild-acceptance.js",
    "test:generation-gate": "tsc -p tsconfig.test.json && node .test-dist/tests/generation-gate-acceptance.js"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "sqlite3": "5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^9.23.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.29.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shirmy/ST-WeaveMemory-Server.git"
  }
}
